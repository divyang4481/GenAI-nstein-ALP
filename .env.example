AWS_REGION=us-east-1
AWS_PROFILE=retailflow-demo
BEDROCK_MODEL=us.amazon.nova-lite-v1:0
DATABASE_URL=postgresql+asyncpg://retailflow:retailflow@postgres:5432/retailflow
QDRANT_URL=http://qdrant:6333
MCP_SERVER_URL=http://mcp-server:8001
MCP_SERVICE_TOKEN=replace-with-a-random-service-token
AUTO_REPLAY_ON_START=false
